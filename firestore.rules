rules_version = '2';

// Solo la cuenta autorizada puede leer y guardar datos.
// IMPORTANTE: cambia TU_CORREO@ejemplo.com por el correo de la cuenta que creaste
// en Firebase (Authentication > Users), escrito exactamente igual.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.token.email == 'TU_CORREO@ejemplo.com';
    }
  }
}
