rules_version = '2';

// ==========================================================================
//  REGLAS DE SEGURIDAD - Registro Nacional (Calidad y Mallas)
//
//  - "admin" puede todo.
//  - Los trabajadores los crea el admin desde la app (⚙️ > Usuarios).
//    Solo entran los que estén ACTIVOS en esa lista.
//  No hay que cambiar nada en este archivo al agregar o quitar trabajadores.
// ==========================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function cuentaApp() {
      return request.auth != null
        && request.auth.token.email.lower().matches('.*@ecuaroscanada[.]app');
    }

    function nombre() {
      return request.auth.token.email.lower().split('@')[0];
    }

    function esAdmin() {
      return cuentaApp() && nombre() == 'admin';
    }

    function esUsuario() {
      return esAdmin() || (
        cuentaApp()
        && exists(/databases/$(database)/documents/usuarios/$(nombre()))
        && get(/databases/$(database)/documents/usuarios/$(nombre())).data.activo == true
      );
    }

    // Lista de usuarios: solo el admin la maneja; cada uno puede ver su propio estado
    match /usuarios/{id} {
      allow read: if esAdmin() || (cuentaApp() && nombre() == id);
      allow write: if esAdmin();
    }

    // Registros: todos ven y registran; solo el admin corrige o borra
    match /transacciones/{id} {
      allow read, create: if esUsuario();
      allow update, delete: if esAdmin();
    }
    match /mallas/{id} {
      allow read, create: if esUsuario();
      allow update, delete: if esAdmin();
    }

    // Listas (proveedores, variedades, bloques, cosechadores, tallos...):
    // todos las ven; solo el admin las modifica
    match /{lista}/{id} {
      allow read: if esUsuario()
        && lista in ['proveedores', 'clasificadores', 'variedades', 'plagas',
                     'estructuras', 'cosechadores', 'tallos', 'meta'];
      allow write: if esAdmin()
        && lista in ['proveedores', 'clasificadores', 'variedades', 'plagas',
                     'estructuras', 'cosechadores', 'tallos', 'meta'];
    }
  }
}
